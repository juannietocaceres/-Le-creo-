PROVEEDOR=google            # google | groq | openrouter

GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Verificar el nombre vigente del modelo en la página del proveedor antes de usarlo
MODELO_GOOGLE=
MODELO_GROQ=
MODELO_OPENROUTER=

MAX_ITER=5
TIMEOUT_S=20
PRESUPUESTO_TOKENS=8000

# Solo para pruebas: vacío | 429 | timeout | invalida
FORZAR_ERROR=

DATABASE_URL=postgresql://lecreo:lecreo@localhost:5433/lecreo

# Bot de Telegram: créalo con @BotFather (/newbot) y pega aquí el token
TELEGRAM_BOT_TOKEN=
